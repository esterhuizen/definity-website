# Public site URL (used for canonical tags, OpenGraph, sitemap)
NEXT_PUBLIC_SITE_URL=https://definity.finance

# Solana RPC endpoint (only used if you later wire on-chain reads — not required for the embedded Sanctum widget)
# NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Path where the /api/track endpoint appends events. Defaults to
# /var/lib/definity/events.jsonl in production. For local dev, point at
# something writable under the project (and gitignored).
# EVENTS_LOG_PATH=./events.jsonl
