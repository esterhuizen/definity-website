# Public site URL (used for canonical tags, OpenGraph, sitemap)
NEXT_PUBLIC_SITE_URL=https://definity.finance

# Solana RPC endpoint (only used if you later wire on-chain reads — not required for the embedded Sanctum widget)
# NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Path where the /api/track endpoint appends events. Defaults to
# /var/lib/definity/events.jsonl in production. For local dev, point at
# something writable under the project (and gitignored).
# EVENTS_LOG_PATH=./events.jsonl

# Directed-stake data paths (the /direct-staking widget + its /api/direct-stake/* routes).
#   - REGISTRY: the DSP scanner's on-chain deposit log (READ-only from the web app).
#   - WEBHOOK:  the instant-ingest log — /api/direct-stake/ingest APPENDS a deposit
#               here the moment the widget confirms one, so the dashboard reflects it
#               in seconds instead of waiting ~an epoch-slot for the scanner. The
#               balance/requests routes merge WEBHOOK + REGISTRY (dedup by signature).
#   - DEPLOYMENTS: the optimiser's placed-stake log (READ-only).
#
# CRITICAL: DIRECTED_WEBHOOK_PATH is WRITTEN by the web service, so it MUST live inside
# the systemd unit's ReadWritePaths (deploy/definity{,-staging}.service):
#   prod    → /var/lib/definity/…          (NOT /var/lib/definity-dsp — that dir is
#             read-only to this service under ProtectSystem=strict; pointing the webhook
#             there fails every ingest with EROFS and silently degrades to scanner lag,
#             which mis-attributes a fresh stake to the wallet's PREVIOUS validator).
#   staging → /var/lib/definity-staging/…
# The code default is now the prod-writable path, so prod survives a lost env file.
DIRECTED_WEBHOOK_PATH=/var/lib/definity/directed-stake-webhook.jsonl
# DIRECTED_REGISTRY_PATH=/var/lib/definity-dsp/directed-stake-registry.jsonl
# DIRECTED_DEPLOYMENTS_PATH=/var/lib/definity-dsp/directed-deployments.jsonl
