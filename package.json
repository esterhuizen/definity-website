{
  "name": "definity-website",
  "version": "0.1.0",
  "private": true,
  "description": "Definity — a Solana stake pool growing the ecosystem in regions that need it most.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build:embed": "node scripts/build-embed.mjs",
    "build": "(node scripts/build-embed.mjs || echo 'embed bundle: using committed build') && next build",
    "start": "node .next/standalone/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "stats:fetch": "node scripts/fetch-pool-stats.mjs public/stats.json"
  },
  "dependencies": {
    "@solana-program/token": "^0.13.0",
    "@solana/kit": "^6.9.0",
    "@solana/react": "^6.9.0",
    "@solana/web3.js": "^3.0.0-rc.1",
    "@wallet-standard/react": "^1.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.15",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.15",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
