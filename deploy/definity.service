# /etc/systemd/system/definity.service
#
# Runs the Next.js standalone server as a non-login system user.
# After installing:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now definity
#   sudo systemctl status definity
#   journalctl -u definity -f

[Unit]
Description=Definity website (Next.js standalone)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=definity
Group=definity
WorkingDirectory=/var/www/definity/current
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=WHITELIST_LOG_PATH=/var/lib/definity/whitelist-applications.jsonl
# Out-of-repo file holding NOTION_TOKEN + NOTION_DATABASE_ID. Existence is
# optional — if missing, the /api/whitelist endpoint falls back to JSONL-only
# (provision via /root/notion-creds.txt — see SERVER-PROVISIONING.md).
EnvironmentFile=-/etc/default/definity.env
ExecStart=/usr/bin/node /var/www/definity/current/.next/standalone/server.js
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
# MemoryDenyWriteExecute removed: incompatible with V8 JIT (Node crashes with SIGTRAP on baseline-compile).
ReadWritePaths=/var/www/definity /var/lib/definity

[Install]
WantedBy=multi-user.target
