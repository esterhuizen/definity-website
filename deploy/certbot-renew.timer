# /etc/systemd/system/certbot-renew.timer
#
# Runs the renewal twice a day at slightly off-peak hour:minute, with up
# to 1h of randomization so we don't hammer the ACME server in lockstep
# with everyone else on the planet. Persistent=true means a missed run
# (e.g. the box was off) fires as soon as it comes back.
#
# Enable: sudo systemctl daemon-reload && sudo systemctl enable --now certbot-renew.timer
# Inspect: systemctl list-timers certbot-renew.timer
# Disable: sudo systemctl disable --now certbot-renew.timer

[Unit]
Description=Twice-daily renewal check for definity.finance TLS cert
Documentation=man:certbot(1)

[Timer]
OnCalendar=*-*-* 03:17:00
OnCalendar=*-*-* 15:17:00
RandomizedDelaySec=1h
Persistent=true
Unit=certbot-renew.service

[Install]
WantedBy=timers.target
