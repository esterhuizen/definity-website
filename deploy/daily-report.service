# /etc/systemd/system/daily-report.service
#
# Runs scripts/daily-report.mjs once a day. Reads:
#   - /var/lib/definity/events.jsonl                  (written by /api/track)
#   - /var/lib/definity/whitelist-applications.jsonl  (written by /api/whitelist)
#   - /var/log/nginx/access.log                       (read-only; for goaccess country)
#   - /var/lib/GeoIP/dbip-country-lite.mmdb           (read-only; goaccess --geoip-database)
# Writes:
#   - /var/lib/definity/reports/YYYY-MM-DD.html
#   - /var/lib/definity/reports/latest.html
#   - /var/lib/definity/reports/latest-summary.txt
# Reports live OUTSIDE the release tree so they survive deploys.
# The summary text also appears in `journalctl -u daily-report.service`.

[Unit]
Description=Generate Definity daily visitor report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=definity
Group=definity
WorkingDirectory=/var/www/definity/current
Environment=EVENTS_LOG_PATH=/var/lib/definity/events.jsonl
Environment=WHITELIST_LOG_PATH=/var/lib/definity/whitelist-applications.jsonl
Environment=NGINX_ACCESS_LOG=/var/log/nginx/access.log
Environment=GEOIP_DB=/var/lib/GeoIP/dbip-country-lite.mmdb
Environment=REPORTS_DIR=/var/lib/definity/reports
ExecStart=/usr/bin/node scripts/daily-report.mjs
TimeoutStartSec=120

# Hardening — same template as pool-stats.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/www/definity /var/lib/definity
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
LockPersonality=true
# MemoryDenyWriteExecute removed: incompatible with V8 JIT (Node crashes with SIGTRAP).
