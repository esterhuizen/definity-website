# /etc/systemd/system/daily-report-staging.service
#
# Staging twin of daily-report.service. Reads staging's events + whitelist
# logs, writes reports to /var/lib/definity-staging/reports/. Triggered by
# daily-report-staging.timer.

[Unit]
Description=Generate Definity daily visitor report — STAGING
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=definity
Group=definity
WorkingDirectory=/var/www/definity-staging/current
Environment=EVENTS_LOG_PATH=/var/lib/definity-staging/events.jsonl
Environment=WHITELIST_LOG_PATH=/var/lib/definity-staging/whitelist-applications.jsonl
Environment=NGINX_ACCESS_LOG=/var/log/nginx/access.log
Environment=GEOIP_DB=/var/lib/GeoIP/dbip-country-lite.mmdb
Environment=REPORTS_DIR=/var/lib/definity-staging/reports
ExecStart=/usr/bin/node scripts/daily-report.mjs
TimeoutStartSec=120

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/www/definity-staging /var/lib/definity-staging
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
LockPersonality=true
