# /etc/systemd/system/whitelist-backfill.timer
#
# Reconciles JSONL → Notion every hour. Whitelist submissions are sparse
# (a few per week) and the live /api/whitelist path already tries Notion
# synchronously — this timer is the backstop for the rare case where that
# fails. A 1h cadence keeps journal noise low; trade-off is up to 1h
# invisibility for a submission that hits a Notion outage at the wrong moment.
#
# Persistent=true so a missed run catches up. RandomizedDelaySec=5min adds
# jitter vs. clean hour boundaries.
#
# Enable: sudo systemctl daemon-reload && sudo systemctl enable --now whitelist-backfill.timer
# Force run: sudo systemctl start whitelist-backfill.service
# Inspect:   systemctl list-timers whitelist-backfill.timer
# Logs:      journalctl -u whitelist-backfill.service -n 100

[Unit]
Description=Hourly reconciliation of whitelist JSONL → Notion

[Timer]
OnBootSec=5min
OnUnitActiveSec=1h
RandomizedDelaySec=5min
Persistent=true
Unit=whitelist-backfill.service

[Install]
WantedBy=timers.target
